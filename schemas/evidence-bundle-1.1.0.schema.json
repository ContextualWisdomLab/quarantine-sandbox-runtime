{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contextualwisdomlab.org/schemas/quarantine/evidence-bundle-1.1.0.schema.json",
  "title": "Quarantine Evidence Bundle",
  "$comment": "Schema 1.1.0 adds required analysis_job_identity_sha256 evidence while preserving analysis_job_id as an opaque bounded identifier. Cross-field SHA-256 equivalence is enforced by the Rust EvidenceBundle validator because Draft 2020-12 cannot recompute a digest across fields.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "analysis_job_id",
    "analysis_job_identity_sha256",
    "request_id",
    "artifact",
    "runtime",
    "disposition",
    "consumer_verdict_required",
    "evidence",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1.0"
    },
    "analysis_job_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]*$",
      "x-cwl-maxUtf8Bytes": 128
    },
    "analysis_job_identity_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]*$",
      "x-cwl-maxUtf8Bytes": 128
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_name",
        "original_file_name",
        "artifact_size_bytes",
        "artifact_sha256",
        "artifact_kind"
      ],
      "properties": {
        "artifact_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]*$",
          "x-cwl-maxUtf8Bytes": 255
        },
        "original_file_name": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 255,
          "pattern": "^(?!\\.{1,2}$)[^/\\\\\\u0000-\\u001F\\u007F-\\u009F]{1,255}$",
          "x-cwl-maxUtf8Bytes": 255
        },
        "artifact_size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "artifact_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "artifact_kind": {
          "enum": [
            "portable_executable",
            "elf_executable",
            "mach_o_executable",
            "zip_archive",
            "pdf_document",
            "ole_compound_document",
            "script",
            "text",
            "unknown"
          ]
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime_name",
        "runtime_version",
        "source_revision",
        "requested_profile",
        "dynamic_execution_performed",
        "network_access_performed",
        "credentials_available"
      ],
      "properties": {
        "runtime_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]*$",
          "x-cwl-maxUtf8Bytes": 128
        },
        "runtime_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]*$",
          "x-cwl-maxUtf8Bytes": 128
        },
        "source_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]*$",
          "x-cwl-maxUtf8Bytes": 128
        },
        "requested_profile": {
          "enum": [
            "static_only",
            "linux_dynamic",
            "windows_dynamic"
          ]
        },
        "dynamic_execution_performed": {
          "const": false
        },
        "network_access_performed": {
          "const": false
        },
        "credentials_available": {
          "const": false
        }
      }
    },
    "disposition": {
      "enum": [
        "completed",
        "inconclusive",
        "failed"
      ]
    },
    "consumer_verdict_required": {
      "const": true
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "sequence_number",
          "evidence_kind",
          "producer_id",
          "summary",
          "attributes"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]*$",
            "x-cwl-maxUtf8Bytes": 256
          },
          "sequence_number": {
            "type": "integer",
            "minimum": 1
          },
          "evidence_kind": {
            "enum": [
              "artifact_identity",
              "file_format",
              "policy_boundary",
              "static_capability",
              "runtime_behavior",
              "network_attempt",
              "tool_failure"
            ]
          },
          "producer_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]*$",
            "x-cwl-maxUtf8Bytes": 128
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]*$",
            "x-cwl-maxUtf8Bytes": 4096
          },
          "attributes": {
            "type": "object",
            "maxProperties": 32,
            "propertyNames": {
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]*$",
              "x-cwl-maxUtf8Bytes": 128
            },
            "additionalProperties": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]*$",
              "x-cwl-maxUtf8Bytes": 1024
            }
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]*$",
        "x-cwl-maxUtf8Bytes": 256
      },
      "uniqueItems": true
    }
  }
}
