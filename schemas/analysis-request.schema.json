{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contextualwisdomlab.org/schemas/quarantine/analysis-request-1.0.0.schema.json",
  "title": "Quarantine Analysis Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "profile"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]*$",
      "x-cwl-maxUtf8Bytes": 128
    },
    "profile": {
      "enum": [
        "static_only",
        "linux_dynamic",
        "windows_dynamic"
      ]
    },
    "bounded_source_context": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "minProperties": 1,
      "x-cwl-maxSerializedUtf8Bytes": 1024,
      "properties": {
        "source_channel_code": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64,
          "pattern": "^[a-z0-9_]{1,64}$",
          "x-cwl-maxUtf8Bytes": 64
        },
        "original_file_name": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 255,
          "pattern": "^(?!\\.{1,2}$)[^/\\\\\\u0000-\\u001F\\u007F-\\u009F]{1,255}$",
          "x-cwl-maxUtf8Bytes": 255
        },
        "declared_media_type": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 255,
          "pattern": "^[A-Za-z0-9!#$&^_.+-]+/[A-Za-z0-9!#$&^_.+-]+(?:;[\\t\\u0020-\\u007E]+)?$",
          "x-cwl-maxUtf8Bytes": 255
        },
        "host_artifact_reference": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$",
          "not": {
            "pattern": "^(?:[Gg][Ii][Tt][Hh][Uu][Bb]_[Pp][Aa][Tt]_|[Bb][Ee][Aa][Rr][Ee][Rr]_).*"
          },
          "x-cwl-maxUtf8Bytes": 128
        },
        "submitted_at": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 30,
          "format": "date-time",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9](?::(?:[0-5][0-9]|60))(?:\\.[0-9]+)?Z$",
          "x-cwl-maxUtf8Bytes": 30,
          "x-cwl-rfc3339Profile": "utc_z_only_with_gregorian_day_validation"
        }
      }
    }
  }
}
