{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contextualwisdomlab.org/schemas/quarantine/analysis-request-1.0.0.schema.json",
  "title": "Quarantine Analysis Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "profile",
    "context"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "profile": {
      "enum": [
        "static_only",
        "linux_dynamic",
        "windows_dynamic"
      ]
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_system",
        "source_reference",
        "attributes"
      ],
      "properties": {
        "source_system": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "source_reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "attributes": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {
            "minLength": 1,
            "maxLength": 128
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        }
      }
    }
  }
}
