{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contextualwisdomlab.org/schemas/quarantine/command-execution-result-1.0.0.schema.json",
  "title": "Bounded Command Execution Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "image_reference",
    "backend_id",
    "backend_version",
    "sandbox_id",
    "exit_code",
    "timed_out",
    "stdout",
    "stdout_truncated",
    "stderr",
    "stderr_truncated",
    "started_at_epoch_seconds",
    "finished_at_epoch_seconds"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "request_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "image_reference": { "type": "string", "minLength": 73, "maxLength": 512 },
    "backend_id": { "type": "string", "minLength": 1 },
    "backend_version": { "type": "string" },
    "sandbox_id": { "type": "string", "minLength": 1 },
    "exit_code": { "type": "integer" },
    "timed_out": { "type": "boolean" },
    "stdout": { "type": "string" },
    "stdout_truncated": { "type": "boolean" },
    "stderr": { "type": "string" },
    "stderr_truncated": { "type": "boolean" },
    "started_at_epoch_seconds": { "type": "integer", "minimum": 0 },
    "finished_at_epoch_seconds": { "type": "integer", "minimum": 0 },
    "source_artifact_receipt": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "revision_sha",
            "tree_sha256",
            "executable_files_stripped",
            "regular_file_count",
            "total_bytes",
            "mounted_read_only",
            "mounted_noexec"
          ],
          "properties": {
            "revision_sha": {
              "type": "string",
              "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
            },
            "tree_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "executable_files_stripped": { "type": "integer", "minimum": 0 },
            "regular_file_count": { "type": "integer", "minimum": 0 },
            "total_bytes": { "type": "integer", "minimum": 0 },
            "mounted_read_only": { "type": "boolean" },
            "mounted_noexec": { "type": "boolean" }
          }
        }
      ]
    }
  }
}
