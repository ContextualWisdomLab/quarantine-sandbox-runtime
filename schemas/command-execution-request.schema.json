{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contextualwisdomlab.org/schemas/quarantine/command-execution-request-1.0.0.schema.json",
  "title": "Bounded Command Execution Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "image_reference",
    "command",
    "resources"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]*$",
      "x-cwl-maxUtf8Bytes": 128
    },
    "image_reference": {
      "type": "string",
      "minLength": 73,
      "maxLength": 512,
      "pattern": "^[^\\s\\u0000-\\u001F\\u007F-\\u009F]+@sha256:[0-9a-f]{64}$",
      "x-cwl-maxUtf8Bytes": 512
    },
    "command": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024,
        "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]*$",
        "x-cwl-maxUtf8Bytes": 1024
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "memory_bytes",
        "cpu_millicores",
        "maximum_processes",
        "lease_seconds",
        "tmpfs_bytes"
      ],
      "properties": {
        "memory_bytes": { "type": "integer", "minimum": 1 },
        "cpu_millicores": { "type": "integer", "minimum": 1 },
        "maximum_processes": { "type": "integer", "minimum": 1 },
        "lease_seconds": { "type": "integer", "minimum": 1 },
        "tmpfs_bytes": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
